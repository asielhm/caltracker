# Configure privately; never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
APP_PASSWORD=
HOST=127.0.0.1
PORT=3000
# For a Node deployment behind an HTTPS proxy, set its exact external origin.
PUBLIC_ORIGIN=

# Provision through Vercel Storage → Upstash Redis; server-only credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
